# Copy to .env and fill in. With NO provider set, the POC runs offline using a
# deterministic stub LLM, so `python run_poc.py` works out of the box.

# ---- Pick ONE free provider for real LLM reasoning ----

# Groq (recommended for dev): free, no credit card, OpenAI-compatible, fast.
#   Sign up: https://console.groq.com  ->  create API key
LLM_PROVIDER=groq
GROQ_API_KEY=

# Default model is llama-3.3-70b-versatile (good tool use / reasoning).
# For higher request volume use the workhorse below:
# LLM_MODEL=llama-3.1-8b-instant

# ---- Other free / local options (uncomment one) ----
# Google Gemini (free tier):
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=
# LLM_MODEL=gemini-2.0-flash

# OpenRouter (has free models):
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Ollama (fully local, no key):  run `ollama serve` first
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.1

# Force offline deterministic mode:
# LLM_PROVIDER=stub

# ---- Real GitHub PRs (optional; default is local mode, no GitHub needed) ----
# GITHUB_TOKEN=
